# Target of `task migrate:* ENV=prod`: copy to .env.prod (git-ignored) and fill in.
# Same keys as configs/config.yaml (db.*), as {{ cookiecutter.env_prefix }}_DB_* env vars.
# Make one file per environment: .env.staging, .env.prod, ...
{{ cookiecutter.env_prefix }}_DB_HOST=127.0.0.1 # e.g. through the Cloud SQL Auth Proxy or a bastion tunnel
{{ cookiecutter.env_prefix }}_DB_PORT=5432
{{ cookiecutter.env_prefix }}_DB_USER={{ cookiecutter.project_slug }}
{{ cookiecutter.env_prefix }}_DB_PASSWORD=CHANGE_ME
{{ cookiecutter.env_prefix }}_DB_NAME={{ cookiecutter.project_slug }}
{{ cookiecutter.env_prefix }}_DB_SSLMODE=require
{{ cookiecutter.env_prefix }}_LOG_FORMAT=text
